= df.dropna(subset=['month'])\n","\n","    # Filter to include only January and February\n","    df = df[df['month'].dt.month.isin([1, 2])]\n","\n","    # Extract year\n","    df['year'] = df['month'].dt.year\n","\n","    # Group by year and calculate the average resale price\n","    df_yearly = df.groupby('year')['resale_price'].mean().reset_index()\n","\n","    # Calculate % increase from previous year\n","    df_yearly['pct_change'] = df_yearly['resale_price'].pct_change() * 100\n","\n","    # Print year, average, and % change\n","    print(df_yearly.to_string(index=False, formatters={\n","        'resale_price': '{:,.2f}'.format,\n","        'pct_change': lambda x: f'{x:.2f}%' if pd.notnull(x) else 'N/A'\n","    }))\n","\n","    # Plotting\n","    plt.figure(figsize=(10, 6))\n","    plt.plot(df_yearly['year'], df_yearly['resale_price'], marker='o', label='Avg Price (Jan-Feb)')\n","\n","    # Annotate % change on plot\n","    for i in range(1, len(df_yearly)):\n","        x = df_yearly.loc[i, 'year']\n","        y = df_yearly.loc[i, 'resale_price']\n","        pct = df_yearly.loc[i, 'pct_change']\n","        plt.annotate(f'{pct:.1f}%', (x, y), textcoords=\"offset points\", xytext=(0, 8), ha='center', fontsize=9, color='green')\n","\n","    plt.xlabel(\"Year\")\n","    plt.ylabel(\"Average Resale Price (Jan & Feb)\")\n","    plt.title(\"Average Resale Price for Jan & Feb by Year\")\n","    plt.grid(True)\n","    plt.legend()\n","    plt.tight_layout()\n","    plt.show()\n"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"MlkImvWn_F_t"},"outputs":[],"source":["# resale price over time group by flat type (no. of rooms)\n","def plot_price_over_time_by_flat_type(df):\n","    df['month'] = pd.to_datetime(df['month'], errors='coerce')\n","    df = df.dropna(subset=['month'])\n","\n","    df_grouped = df.groupby([pd.Grouper(key='month', freq='M'), 'flat_type'])['resale_price'].mean().reset_index()\n","\n","    plt.figure(figsize=(12, 6))\n","    for flat_type in df_grouped['flat_type'].unique():\n","        subset = df_grouped[df_grouped['flat_type'] == flat_type]\n","        plt.plot(subset['month'], subset['resale_price'], label=flat_type)\n","\n","    plt.xlabel(\"Month\")\n","    plt.ylabel(\"Average Resale Price\")\n","    plt.title(\"Resale Price Over Time by Flat Type\")\n","    plt.legend(title=\"Flat Type\")\n","    plt.grid(True)\n","    plt.tight_layout()\n","    plt.show()"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"6z9oRxNE_JfF"},"outputs":[],"source":["# resale price over time grouped by town\n","def plot_price_over_time_by_town(df, max_towns=6):\n","    df['month'] = pd.to_datetime(df['month'], errors='coerce')\n","    df = df.dropna(subset=['month'])\n","\n","    top_towns = df['town'].value_counts().nlargest(max_towns).index\n","    df = df[df['town'].isin(top_towns)]\n","\n","    df_grouped = df.groupby([pd.Grouper(key='month', freq='M'), 'town'])['resale_price'].mean().reset_index()\n","\n","    plt.figure(figsize=(12, 6))\n","    for town in top_towns:\n","        subset = df_grouped[df_grouped['town'] == town]\n","        plt.plot(subset['month'], subset['resale_price'], label=town)\n","\n","    plt.xlabel(\"Month\")\n","    plt.ylabel(\"Average Resale Price\")\n","    plt.title(f\"Resale Price Over Time by Town (Top {max_towns})\")\n","    plt.legend(title=\"Town\")\n","    plt.grid(True)\n","    plt.tight_layout()\n","    plt.show()"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"8T8aCSth_J4q"},"outputs":[],"source":["\n","\n","def plot_histograms_by_town(df, max_towns=6, bins=20):\n","    df['month'] = pd.to_datetime(df['month'], errors='coerce')\n","    df = df.dropna(subset=['month'])\n","\n","    top_towns = df['town'].value_counts().nlargest(max_towns).index\n","    df = df[df['town'].isin(top_towns)]\n","\n","    plt.figure(figsize=(14, 8))\n","\n","    # Create a histogram for each town\n","    for i, town in enumerate(top_towns, 1):\n","        plt.subplot(2, 3, i)  # Adjust grid layout if necessary\n","        subset = df[df['town'] == town]\n","\n","        # Plot histogram\n","        plt.hist(subset['resale_price'], bins=bins, color='skyblue', edgecolor='black', alpha=0.7)\n","\n","        plt.title(f\"Resale Price Distribution for {town}\")\n","        plt.xlabel(\"Resale Price\")\n","        plt.ylabel(\"Count\")\n","        plt.grid(True)\n","\n","    plt.tight_layout()\n","    plt.show()\n","\n"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"MTTa__mc_RGg"},"outputs":[],"source":["# plot resale price vs remaining lease\n","\n","def convert_remaining_lease_to_years(lease_str):\n","    match = re.match(r\"(\\d+)\\s+years\\s*(\\d*)\", str(lease_str))\n","    if match:\n","        years = int(match.group(1))\n","        months = int(match.group(2)) if match.group(2).isdigit() else 0\n","        return years + months / 12\n","    return None\n","\n","def plot_price_vs_lease_year_groups(df):\n","    df['lease_years'] = df['remaining_lease'].apply(convert_remaining_lease_to_years)\n","    df = df.dropna(subset=['lease_years'])\n","\n","    # Round lease years to nearest year for grouping\n","    df['lease_year_group'] = df['lease_years'].round().astype(int)\n","\n","    grouped = df.groupby('lease_year_group')['resale_price'].mean().reset_index()\n","\n","    plt.figure(figsize=(10, 6))\n","    plt.plot(grouped['lease_year_group'], grouped['resale_price'], marker='o')\n","    plt.xlabel(\"Remaining Lease (Years)\")\n","    plt.ylabel(\"Average Resale Price\")\n","    plt.title(\"Average Resale Price by Remaining Lease Duration\")\n","    plt.grid(True)\n","    plt.tight_layout()\n","    plt.show()"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"UFHFz_FQ_TsT"},"outputs":[],"source":["# group the range of floors, and then plot the price over time but group by the floor buckets\n","def plot_price_over_time_by_floor(df):\n","    df['month'] = pd.to_datetime(df['month'], errors='coerce'